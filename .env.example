# Trends — environment variables
# Copy to .env for local development.

# HTTP server
PORT=3000
NODE_ENV=development

# NATS broker
# In production this is the docker-network hostname of the NATS container
# (dividend-portfolio-nats). In local dev, point at the docker-compose service.
NATS_HOST=localhost
NATS_PORT=4222
NATS_ENV_PREFIX=dev

# Database
# Local dev: matches docker-compose.dev.yml credentials.
DATABASE_URL=postgresql://trends:trends@localhost:5432/trends?schema=public

# API auth — comma-separated list of accepted keys for X-API-Key header.
# Generate one with: openssl rand -hex 32
TRENDS_API_KEYS=dev-key-change-me
